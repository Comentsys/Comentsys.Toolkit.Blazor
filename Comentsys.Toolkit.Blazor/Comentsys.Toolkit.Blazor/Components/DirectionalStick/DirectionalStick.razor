@namespace Comentsys.Toolkit.Blazor
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 @Total @Total" width="@Total" height="@Total"
    @onpointerdown="StartCapture" @onpointermove="MoveKnob"
    @onpointerup="EndCapture" @onpointerleave="EndCapture" @onpointercancel="EndCapture"
    style="touch-action: none; user-select: none">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <title>@Title</title>
    }
    <circle cx="@Centre" cy="@Centre" r="@Radius" fill="@_fill" pointer-events="none" />
    <circle cx="@_knobX" cy="@_knobY" r="@Knob" fill="@_foreground" pointer-events="none" />
</svg>